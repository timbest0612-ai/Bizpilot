# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYSTACK_SECRET_KEY: For collecting live payments into your Nigerian/African bank account
PAYSTACK_SECRET_KEY=""

# VITE_PAYSTACK_PUBLIC_KEY: Frontend public key for Paystack checkout popup
VITE_PAYSTACK_PUBLIC_KEY=""

# RESELLER_API_PROVIDER: Upstream registrar API (e.g. namecheap, resellerclub, web4africa)
RESELLER_API_PROVIDER=""

# RESELLER_API_KEY: API Key from upstream registrar to book real domains in ICANN/NiRA registries
RESELLER_API_KEY=""

# RESELLER_AUTH_USER: Upstream registrar reseller username or account ID
RESELLER_AUTH_USER=""

# RESEND_API_KEY: High-throughput API key for transactional and multi-email bulk broadcasting
RESEND_API_KEY=""

# SENDGRID_API_KEY: Backup enterprise email API key
SENDGRID_API_KEY=""

# VITE_GOOGLE_CLIENT_ID: Google OAuth 2.0 Web Client ID for 1-click customer sign-in and email capture
VITE_GOOGLE_CLIENT_ID=""

# AWS_SES_ACCESS_KEY_ID: Amazon SES credentials for sending up to 100,000+ emails affordably ($10/100k)
AWS_SES_ACCESS_KEY_ID=""
AWS_SES_SECRET_ACCESS_KEY=""
AWS_SES_REGION="us-east-1"
